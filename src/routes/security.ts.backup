import express from 'express';
import { SecurityMonitor } from '../services/security-monitor';
import { authenticateToken } from '../middlewares/auth.middleware';
import { apiRateLimit } from '../middleware/security-middleware';
import { Request, Response, NextFunction } from 'express';

// Simple admin check middleware
const requireAdmin = (req: Request, res: Response, next: NextFunction) => {
  const user = (req as any).user;

  if (!user || user.role !== 'admin') {
    return res.status(403).json({
      error: 'Forbidden',
      message: 'Admin access required'
    });
  }

  next();
};

const router = express.Router();

/**
 * Security Dashboard Routes
 * These endpoints provide security monitoring data for administrators
 */

/**
 * GET /api/security/stats
 * Get security dashboard statistics
 */
router.get('/stats', authenticateToken, requireAdmin, apiRateLimit, async (req, res) => {
  try {
    const timeframe = req.query.timeframe as 'hour' | 'day' | 'week' || 'day';

    if (!['hour', 'day', 'week'].includes(timeframe)) {
      return res.status(400).json({
        error: 'Invalid timeframe',
        message: 'Timeframe must be one of: hour, day, week'
      });
    }

    const stats = await SecurityMonitor.getSecurityStats(timeframe);

    res.json({
      success: true,
      data: {
        timeframe,
        stats,
        generatedAt: new Date().toISOString()
      }
    });

  } catch (error) {
    console.error('Error fetching security stats:', error);
    res.status(500).json({
      error: 'Internal server error',
      message: 'Unable to fetch security statistics'
    });
  }
});

/**
 * GET /api/security/events
 * Get recent security events (paginated)
 */
router.get('/events', authenticateToken, requireAdmin, apiRateLimit, async (req, res) => {
  try {
    const page = parseInt(req.query.page as string) || 1;
    const limit = Math.min(parseInt(req.query.limit as string) || 20, 100);
    const eventType = req.query.eventType as string;
    const severity = req.query.severity as string;

    // Get basic stats to extract recent events
    const stats = await SecurityMonitor.getSecurityStats('week');
    let events = stats.recentEvents || [];

    // Apply filters
    if (eventType) {
      events = events.filter((event: any) => event.type === eventType);
    }

    if (severity) {
      events = events.filter((event: any) => event.severity === severity);
    }

    // Apply pagination
    const startIndex = (page - 1) * limit;
    const endIndex = startIndex + limit;
    const paginatedEvents = events.slice(startIndex, endIndex);

    res.json({
      success: true,
      data: {
        events: paginatedEvents,
        pagination: {
          page,
          limit,
          total: events.length,
          pages: Math.ceil(events.length / limit)
        },
        filters: {
          eventType,
          severity
        }
      }
    });

  } catch (error) {
    console.error('Error fetching security events:', error);
    res.status(500).json({
      error: 'Internal server error',
      message: 'Unable to fetch security events'
    });
  }
});

/**
 * GET /api/security/suspicious-ips
 * Get list of currently flagged suspicious IPs
 */
router.get('/suspicious-ips', authenticateToken, requireAdmin, apiRateLimit, async (req, res) => {
  try {
    // Note: This would require extending SecurityMonitor to expose suspicious IPs list
    // For now, we'll return a placeholder response
    res.json({
      success: true,
      data: {
        suspiciousIPs: [],
        message: 'Suspicious IP tracking is active. IPs are automatically flagged based on behavior patterns.'
      }
    });

  } catch (error) {
    console.error('Error fetching suspicious IPs:', error);
    res.status(500).json({
      error: 'Internal server error',
      message: 'Unable to fetch suspicious IPs'
    });
  }
});

/**
 * POST /api/security/test-alert
 * Test security alert system (development/testing only)
 */
router.post('/test-alert', authenticateToken, requireAdmin, async (req, res) => {
  try {
    if (process.env.NODE_ENV === 'production') {
      return res.status(403).json({
        error: 'Forbidden',
        message: 'Test alerts are not available in production'
      });
    }

    const { eventType, severity, message } = req.body;

    if (!eventType || !severity) {
      return res.status(400).json({
        error: 'Missing required fields',
        message: 'eventType and severity are required'
      });
    }

    // Create a test security event
    const testEvent = SecurityMonitor.createSecurityEventFromRequest(
      req,
      eventType,
      severity,
      {
        testAlert: true,
        message: message || 'Test security alert',
        triggeredBy: (req as any).user?.email || 'admin'
      }
    );

    await SecurityMonitor.logSecurityEvent(testEvent);

    res.json({
      success: true,
      message: 'Test security alert created successfully',
      event: {
        type: testEvent.type,
        severity: testEvent.severity,
        timestamp: testEvent.timestamp
      }
    });

  } catch (error) {
    console.error('Error creating test alert:', error);
    res.status(500).json({
      error: 'Internal server error',
      message: 'Unable to create test alert'
    });
  }
});

/**
 * GET /api/security/health
 * Security system health check
 */
router.get('/health', authenticateToken, requireAdmin, async (req, res) => {
  try {
    // Check Redis connectivity and security monitoring system health
    const healthChecks = {
      redis: false,
      securityMonitoring: false,
      alertSystem: false
    };

    try {
      // Test basic SecurityMonitor functionality
      const testStats = await SecurityMonitor.getSecurityStats('hour');
      healthChecks.securityMonitoring = true;
      healthChecks.redis = true; // If stats work, Redis is working
      healthChecks.alertSystem = true; // Basic functionality indicates alert system is working
    } catch (error) {
      console.error('Security health check failed:', error);
    }

    const overallHealth = Object.values(healthChecks).every(status => status);

    res.status(overallHealth ? 200 : 503).json({
      success: overallHealth,
      data: {
        status: overallHealth ? 'healthy' : 'degraded',
        checks: healthChecks,
        timestamp: new Date().toISOString()
      }
    });

  } catch (error) {
    console.error('Error checking security health:', error);
    res.status(500).json({
      error: 'Internal server error',
      message: 'Unable to check security system health'
    });
  }
});

export default router;