# GEO Platform Frontend Environment Configuration Example

# API Configuration
VITE_API_URL=https://api-geo.blitzgame.site

# Application Configuration  
VITE_APP_NAME="GEO Platform"
VITE_APP_VERSION=1.0.0

# Development Configuration
VITE_DEV_MODE=true
VITE_DEBUG_API=true

# Feature Flags
VITE_ENABLE_SEO_FEATURES=false
VITE_ENABLE_ALERTS=false

# Settings Page Feature Controls
VITE_ENABLE_NOTIFICATIONS_SETTINGS=false
VITE_ENABLE_INTEGRATIONS_SETTINGS=false
VITE_ENABLE_APPEARANCE_SETTINGS=false