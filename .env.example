# Application
NODE_ENV=development
PORT=8000
API_VERSION=v1
FRONTEND_URL=http://localhost:3000

# Database - NEVER COMMIT REAL CREDENTIALS
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_MIN_20_CHARS

# Redis - NEVER COMMIT REAL CREDENTIALS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# Authentication - CRITICAL: Generate unique values!
JWT_SECRET=GENERATE_RANDOM_64_CHAR_STRING_USE_OPENSSL_RAND
JWT_PRIVATE_KEY_PATH=/path/to/private-key.pem
JWT_PUBLIC_KEY_PATH=/path/to/public-key.pem
JWT_EXPIRY=5m
JWT_REFRESH_EXPIRY=24h
BCRYPT_ROUNDS=12

# External APIs - Get from providers, NEVER commit real keys
OPENAI_API_KEY=sk-...YOUR_KEY_HERE
ANTHROPIC_API_KEY=sk-ant-...YOUR_KEY_HERE
PERPLEXITY_API_KEY=pplx-...YOUR_KEY_HERE
GOOGLE_API_KEY=AIza...YOUR_KEY_HERE
GOOGLE_GEMINI_API_KEY=AIza...YOUR_KEY_HERE

# Crawler Settings
CRAWLER_USER_AGENT=GEO-Platform-Bot/1.0
CRAWLER_RATE_LIMIT=10
CRAWLER_TIMEOUT=30000

# Email (SendGrid) - Get from SendGrid dashboard
SENDGRID_API_KEY=SG...YOUR_KEY_HERE
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=GEO Platform

# Stripe - Get from Stripe dashboard
STRIPE_PUBLIC_KEY=pk_test_...YOUR_KEY_HERE
STRIPE_SECRET_KEY=sk_test_...YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_...YOUR_SECRET_HERE

# AWS S3 - Get from AWS IAM
AWS_ACCESS_KEY_ID=AKIA...YOUR_KEY_HERE
AWS_SECRET_ACCESS_KEY=...YOUR_SECRET_HERE
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# Monitoring
SENTRY_DSN=https://...YOUR_DSN_HERE@sentry.io/...
NEW_RELIC_LICENSE_KEY=...YOUR_KEY_HERE

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Security Settings - CRITICAL
ENCRYPTION_KEY=GENERATE_32_BYTE_HEX_STRING
CONFIG_ENCRYPTION_KEY=GENERATE_ANOTHER_32_BYTE_HEX_STRING
CSRF_SECRET=GENERATE_RANDOM_32_CHAR_STRING
SESSION_SECRET=GENERATE_RANDOM_64_CHAR_STRING

# Vault Configuration (for production)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=YOUR_VAULT_TOKEN